#!/usr/bin/env node
'use strict';
// Interactive Amp stand-in. Records byte-exact pasted turns outside the worktree; no provider is contacted.
const { appendFileSync, readFileSync } = require('node:fs');
const { dirname, join } = require('node:path');
const args = process.argv.slice(2);
if (args.includes('--version')) {
  process.stdout.write('amp 99.0.0\n');
  process.exit(0);
}
if (args.includes('--help')) {
  process.stdout.write('amp --execute --stream-json --stream-json-input --mcp-config\n');
  process.exit(0);
}
const mcpFile = args[args.indexOf('--mcp-config') + 1];
if (!mcpFile) process.exit(2);
const history = join(dirname(mcpFile), 'input.history');
const settings = JSON.parse(readFileSync(join(process.cwd(), '.amp', 'settings.json'), 'utf8'));
const mcp = JSON.parse(readFileSync(mcpFile, 'utf8'));
process.stdin.setRawMode?.(true);
process.stdout.write('\x1b[?2004hAmp ready\r\n');
let pending = '';
let first = true;
process.stdin.on('data', (chunk) => {
  pending += chunk.toString();
  while (true) {
    const begin = pending.indexOf('\x1b[200~');
    let text;
    if (begin >= 0) {
      const end = pending.indexOf('\x1b[201~', begin + 6);
      if (end < 0 || !pending.slice(end + 6).includes('\r')) return;
      text = pending.slice(begin + 6, end);
      pending = pending.slice(end + 7);
    } else {
      const end = pending.indexOf('\r');
      if (end < 0) return;
      text = pending.slice(0, end);
      pending = pending.slice(end + 1);
    }
    appendFileSync(history, JSON.stringify({ text, cwd: process.cwd(), settings, mcp, args }) + '\n');
    process.stdout.write('Amp reply: pong\r\n');
    if (first) {
      first = false;
      process.stdout.write('Approve tool (y/n): ');
    } else if (text === 'y') process.stdout.write('Tool approved in Amp terminal\r\n');
  }
});
